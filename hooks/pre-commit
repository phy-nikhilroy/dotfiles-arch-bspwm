#!/usr/bin/env bash
set -euo pipefail

# 1. Verify Author Identity
AUTHOR_NAME="$(git config user.name || true)"
AUTHOR_EMAIL="$(git config user.email || true)"

EXPECTED_NAME="Nikhil Roy"
EXPECTED_EMAIL="phy.nikhilroy@gmail.com"

if [ "$AUTHOR_NAME" != "$EXPECTED_NAME" ] || [ "$AUTHOR_EMAIL" != "$EXPECTED_EMAIL" ]; then
    echo "[ERROR] Invalid git author identity."
    echo "  Expected: $EXPECTED_NAME <$EXPECTED_EMAIL>"
    echo "  Actual:   $AUTHOR_NAME <$AUTHOR_EMAIL>"
    exit 1
fi

# 2. Syntax validation for staged shell scripts
STAGED_SHELL_FILES="$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(sh|bash)$|bspwmrc$|launch\.sh$' || true)"
if [ -n "$STAGED_SHELL_FILES" ]; then
    for file in $STAGED_SHELL_FILES; do
        if [ -f "$file" ]; then
            if ! bash -n "$file"; then
                echo "[ERROR] Shell syntax error in: $file"
                exit 1
            fi
        fi
    done
fi

# 3. Syntax validation for staged Lua files
STAGED_LUA_FILES="$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.lua$' || true)"
if [ -n "$STAGED_LUA_FILES" ]; then
    for file in $STAGED_LUA_FILES; do
        if [ -f "$file" ]; then
            if command -v luac >/dev/null 2>&1; then
                if ! luac -p "$file" >/dev/null 2>&1; then
                    echo "[ERROR] Lua syntax error in: $file"
                    exit 1
                fi
            fi
        fi
    done
fi

exit 0
